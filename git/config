[ghq]
	root = ~/workspace
[init]
	defaultBranch = main
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rebase]
	autoStash = true
